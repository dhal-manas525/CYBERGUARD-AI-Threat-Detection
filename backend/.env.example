# CYBERGUARD Backend Configuration
PROJECT_NAME="CYBERGUARD"
VERSION="1.0.0"
API_V1_STR="/api"
SECRET_KEY="cyberguard_super_secure_jwt_secret_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default for easy setup, or PostgreSQL: postgresql://user:pass@localhost:5432/cyberguard)
DATABASE_URL="sqlite:///./cyberguard.db"

# CORS Configuration (comma-separated list of origins)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Environment
ENVIRONMENT="development"
DEMO_MODE=true
